  "components": {
    "schemas": {
      "Body_upload_v1_transcriptions_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_v1_transcriptions_post"
      },
      "Completion": {
        "properties": {
          "lease_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Lease Token"
          },
          "result": {
            "$ref": "#/components/schemas/Transcript"
          }
        },
        "type": "object",
        "required": [
          "lease_token",
          "result"
        ],
        "title": "Completion"
      },
      "Failure": {
        "properties": {
          "lease_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Lease Token"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,80}$",
            "title": "Code"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "lease_token",
          "code"
        ],
        "title": "Failure"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "title": "State"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "resource_id",
          "kind",
          "state",
          "attempts",
          "error_code",
          "created_at",
          "updated_at"
        ],
        "title": "Job"
      },
      "Lease": {
        "properties": {
          "lease_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Lease Token"
          }
        },
        "type": "object",
        "required": [
          "lease_token"
        ],
        "title": "Lease"
      },
      "Segment": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "number",
            "minimum": 0.0,
            "title": "End"
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "title": "Text"
          },
          "speaker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speaker"
          }
        },
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "text"
        ],
        "title": "Segment"
      },
      "Transcript": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language",
            "default": "ru"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "duration": {
            "type": "number",
            "minimum": 0.0,
            "title": "Duration"
          },
          "text": {
            "type": "string",
            "maxLength": 2000000,
            "title": "Text"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "maxItems": 20000,
            "title": "Segments"
          }
        },
        "type": "object",
        "required": [
          "model",
          "duration",
          "text",
          "segments"
        ],
        "title": "Transcript"
      },
      "URLImport": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 8,
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "URLImport"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
