# Save as .env.worker (ignored by Git).
ASR_API_URL=https://example.com/voice-asr/
ASR_WORKER_TOKEN=replace-with-the-server-worker-token
ASR_MODEL=gigaam-v3-e2e-rnnt
ASR_QUANTIZATION=int8
MAX_AUDIO_SECONDS=14400
MAX_UPLOAD_BYTES=268435456
ASR_WORKER_MEMORY=4g
# Reuse the existing local model cache, or docker volume create this name first.
ASR_MODEL_VOLUME=gigaam-api_models
